# ============================================
# OnlineZap - Environment Variables Example
# ============================================
# Скопируйте этот файл в .env и заполните значения
# НЕ коммитьте .env в git!

# Telegram Bot
# Получите токен у @BotFather в Telegram
BOT_TOKEN=your_bot_token_here

# ID админов (comma-separated, числовые ID из Telegram)
ADMIN_IDS_CSV=1853449775

# ID чата админов (для отправки уведомлений)
ADMIN_CHAT_ID_CSV=-1001234567890

# ============================================
# Database
# ============================================
# PostgreSQL (для Amvera):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
#
# SQLite (для локальной разработки):
DATABASE_URL=sqlite+aiosqlite:////data/bookings.db

# ============================================
# Google Sheets
# ============================================
# ID Google Sheets документа
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Имя листа в Google Sheets
GOOGLE_SHEET_NAME=Bookings

# Путь к файлу credentials.json (Google OAuth)
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials.json

# ============================================
# Booking Settings
# ============================================
# Длительность слота в минутах
SLOT_DURATION_MINUTES=60

# Таймаут резервирования слота в секундах (5 минут)
RESERVATION_TIMEOUT_SECONDS=300

# ============================================
# Reminders
# ============================================
# Отправлять напоминание за 24 часа
REMINDER_24H_ENABLED=true

# Отправлять напоминание за 2 часа
REMINDER_2H_ENABLED=true

# ============================================
# MiniApp (для frontend)
# ============================================
# URL backend API (для разработки)
VITE_API_URL=http://localhost:8000

# Для продакшена на Amvera:
# VITE_API_URL=https://onlinezap-backend.amvera.site
