# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_IDS_CSV=1853449775
ADMIN_CHAT_ID_CSV=-1001234567890

# Database (SQLite by default)
# Для PostgreSQL раскомментируйте и настройте:
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/onlinezap
DATABASE_URL=sqlite+aiosqlite:////app/Data/bookings.db

# Google Sheets Configuration
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Bookings
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials.json

# Booking Settings
SLOT_DURATION_MINUTES=60
RESERVATION_TIMEOUT_SECONDS=300

# Reminders
REMINDER_24H_ENABLED=true
REMINDER_2H_ENABLED=true

# MiniApp URL (должен быть HTTPS для продакшена)
MINIAPP_URL=http://localhost:8001/app

# PostgreSQL (опционально, если используется)
# POSTGRES_USER=onlinezap
# POSTGRES_PASSWORD=change_me_in_production
# POSTGRES_DB=onlinezap
