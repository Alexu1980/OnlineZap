# ==========================================
# КОНФИГУРАЦИЯ БОТА ДЛЯ ЗАПИСИ НА КОНСУЛЬТАЦИЮ
# ==========================================

# Токен Telegram бота (от @BotFather)
BOT_TOKEN=your_bot_token_here

# IDs админов через запятую (для уведомлений)
ADMIN_IDS_CSV=123456789

# ID чата админа (куда отправляются уведомления)
ADMIN_CHAT_ID_CSV=123456789

# ==========================================
# GOOGLE SHEETS НАСТРОЙКИ
# ==========================================

# Путь к файлу credentials.json (Service Account)
# Варианты:
#   credentials.json - в корне проекта
#   /app/credentials.json - на сервере
#   ./data/credentials.json - в папке data
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials.json

# ID таблицы Google Sheets (из URL)
# URL: https://docs.google.com/spreadsheets/d/ЭТО_ID/edit
GOOGLE_SHEET_ID=your_sheet_id_here

# Название листа в таблице (вкладка внизу)
GOOGLE_SHEET_NAME=Bookings

# ==========================================
# БАЗА ДАННЫХ
# ==========================================

# URL базы данных (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./Data/bookings.db

# ==========================================
# НАСТРОЙКИ КОНСУЛЬТАЦИЙ
# ==========================================

# Длительность слота в минутах
SLOT_DURATION_MINUTES=60

# Время резерва слота в секундах (300 = 5 минут)
RESERVATION_TIMEOUT_SECONDS=300

# Напоминания
REMINDER_24H_ENABLED=true
REMINDER_2H_ENABLED=true
